load(":defs.bzl", "bun_build")

exports_files(
    glob(["patches/*"]) + [
        "build_bun.py",
        "inputs_1.json",
    ],
    visibility = ["//tests/bun:__pkg__"],
)

# This build runs for hours. Only macOS arm64 inputs are pinned.
bun_build(
    name = "rootbeerz_1",
    source = "@bun_1_src//:build_tree",
    source_marker = "@bun_1_src//:package.json",
    inputs = "@bun_1_inputs//:all",
    inputs_json = "@bun_1_inputs//:inputs.json",
    stock_bun = "@bun_1_stock_darwin_arm64//:bun",
    patch = "patches/0001-system-store-only.patch",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//visibility:public"],
)
