package(default_visibility = ["//visibility:public"])

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

exports_files([
    "build_node.py",
    "node_versions.bzl",
    "sdk.bzl",
])

alias(
    name = "llvm",
    actual = select({
        ":macos_arm64": "@llvm_darwin_arm64//:toolchain",
        ":linux_x64": "@llvm_linux_x64//:toolchain",
    }),
)

alias(
    name = "clang",
    actual = select({
        ":macos_arm64": "@llvm_darwin_arm64//:bin/clang",
        ":linux_x64": "@llvm_linux_x64//:bin/clang",
    }),
)

alias(
    name = "readobj",
    actual = select({
        ":macos_arm64": "@llvm_darwin_arm64//:bin/llvm-readobj",
        ":linux_x64": "@llvm_linux_x64//:bin/llvm-readobj",
    }),
)

alias(
    name = "ninja",
    actual = select({
        ":macos_arm64": "@ninja_darwin//:ninja",
        ":linux_x64": "@ninja_linux//:ninja",
    }),
)

alias(
    name = "sysroot_info",
    actual = select({
        ":macos_arm64": "@macos_sdk//:info.json",
        ":linux_x64": "@linux_sysroot//:info.json",
    }),
)

filegroup(
    name = "sysroot_files",
    srcs = select({
        ":macos_arm64": [],
        ":linux_x64": ["@linux_sysroot//:files"],
    }),
)
