module(name = "rootbeer", version = "0.1.0")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.4.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Stock upstream binaries. The tests use these as the control.
STOCK_BUILD = 'exports_files(["bin/node"])'

http_archive(
    name = "stock_22_darwin_arm64",
    build_file_content = STOCK_BUILD,
    sha256 = "c9e1dbc748b33ed2d14f42445191ecaf14c56259c7a9a26d0042c49ec2b66428",
    strip_prefix = "node-v22.23.4-darwin-arm64",
    urls = ["https://nodejs.org/dist/v22.23.4/node-v22.23.4-darwin-arm64.tar.gz"],
)

http_archive(
    name = "stock_22_linux_x64",
    build_file_content = STOCK_BUILD,
    sha256 = "b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406",
    strip_prefix = "node-v22.23.4-linux-x64",
