module(name = "rootbeer-node", version = "0.1.0")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.4.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Node sources and the stock control binaries. One tag is the whole entry for a version.
# tools/add_node_version.py prints a new tag. Each sha256 comes from the release SHASUMS256.txt.
# old_v8 selects the patches and warning flags that the V8 of Node 16 and 18 needs.
node = use_extension("//bazel:node_versions.bzl", "node")

node.version(
    major = "26",
    version = "26.13.0",
    sha256 = "986ead18ef18256831bae3e57d94aef680a7b84cfd4044f3e8471f833fbd7191",
    stock_darwin_arm64_sha256 = "d38bd5e5a2ddce6bbb5ce45e46e208337da4d51fffe611e567fd32073d6439f6",
    stock_linux_x64_sha256 = "5848553868b402d3fabb5b09270649977780a390f832155721025a08b5104455",
)

node.version(
    major = "24",
    version = "24.22.2",
    sha256 = "b2f5443a34a38d863e87c0f5f80c03630fc16917dfe16f26c1cec44c0b542959",
    stock_darwin_arm64_sha256 = "aa9549349e47dffaa42dcf95d6e06ade8c4bdafc980979883b88767670df385a",
    stock_linux_x64_sha256 = "361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9",
)

node.version(
    major = "22",
    version = "22.23.4",
    sha256 = "4dd79de8cdc85d65cb32f48a75aee1067bf00bf94b96ecc8e4c2f82f6f0272c2",
    stock_darwin_arm64_sha256 = "c9e1dbc748b33ed2d14f42445191ecaf14c56259c7a9a26d0042c49ec2b66428",
    stock_linux_x64_sha256 = "b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406",
