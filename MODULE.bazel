# Node sources. Each sha256 matches the SHASUMS256.txt file of its release.
NODE_SOURCES = {
    "22": ("22.23.4", "4dd79de8cdc85d65cb32f48a75aee1067bf00bf94b96ecc8e4c2f82f6f0272c2"),
    "20": ("20.20.2", "8cb85a81f75169eb811f7b2512cf17a646826430debbe016a7461f31e286fdef"),
    "18": ("18.20.8", "ec60a6d2344ef9e1f093991ca1bb6bbe92c61c29d1762c4b99e08f87dbb91e2f"),
    "16": ("16.20.2", "33188eb11b977113adb65b2e09d71bddd63f12168ba73ceadae6c27938dc9e93"),
}

[
    http_archive(
        name = "node_" + major,
        build_file = "//bazel:node_source.BUILD",
        sha256 = sha256,
        strip_prefix = "node-v" + version,
        urls = ["https://nodejs.org/dist/v{0}/node-v{0}.tar.gz".format(version)],
        # V8 and others ship BUILD files. These files would split the source tree into packages.
        patch_args = ["-p1"],
        patches = [
            "//patches:{}/0001-empty-root-certs.patch".format(major),
            "//patches:{}/0002-force-local-store.patch".format(major),
        ],
        patch_cmds = ["find deps tools -type f \\( -name BUILD -o -name BUILD.bazel \\) -delete"],
    )
    for major, (version, sha256) in NODE_SOURCES.items()
]

