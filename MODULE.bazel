node.version(
    major = "20",
    version = "20.20.2",
    sha256 = "8cb85a81f75169eb811f7b2512cf17a646826430debbe016a7461f31e286fdef",
    stock_darwin_arm64_sha256 = "466e05f3477c20dfb723054dfebffe55bc74660ee77f612166fca121dacb65b6",
    stock_linux_x64_sha256 = "19e56f0825510207dd904f087fe52faa0a4eb6b2aab5f0ea7a33830d04888b8b",
