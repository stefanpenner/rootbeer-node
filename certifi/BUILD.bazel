load("@certifi_stock//:version.bzl", "CERTIFI_VERSION")
load("@rules_python//python:py_binary.bzl", "py_binary")
load(":defs.bzl", "certifi_wheel")

py_binary(
    name = "build_wheel",
    srcs = ["build_wheel.py"],
)

# The manifest pins the version. A bump changes only runtimes/certifi.json.
certifi_wheel(
    name = "rootbeerz_certifi",
    srcs = glob(["src/certifi/*"]),
    version = CERTIFI_VERSION,
    visibility = ["//tests/certifi:__pkg__"],
)
