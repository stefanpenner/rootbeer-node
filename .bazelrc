common --enable_bzlmod

# MODULE.bazel.lock is committed. It pins the hash of every registry file.
# A stale lockfile is an error. Run `bazel mod deps --lockfile_mode=update` to change it.
common --lockfile_mode=error

# Actions get a fixed environment, and no network. A test that needs the network has the tag requires-network.
build --incompatible_strict_action_env
build --sandbox_default_allow_network=false
build --jobs=10
test --test_output=errors
test --test_verbose_timeout_warnings

# The node build action runs a long time. Keep the machine usable.
build --local_resources=cpu=10

# The build uses the pinned toolchain only. Do not look for a host C++ compiler.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
# The default Python bootstrap needs python3 on the host PATH.
build --@rules_python//python/config_settings:bootstrap_impl=script

try-import %workspace%/user.bazelrc
