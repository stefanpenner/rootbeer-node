common --enable_bzlmod

# MODULE.bazel.lock is committed. It pins the hash of every registry file.
# A stale lockfile is an error. Run `bazel mod deps --lockfile_mode=update` to change it.
common --lockfile_mode=error

# Actions get a fixed environment, and no network. A test that needs the network has the tag requires-network.
build --incompatible_strict_action_env
build --sandbox_default_allow_network=false
build --jobs=10
test --test_output=errors
test --test_verbose_timeout_warnings

# The node build action runs a long time. Keep the machine usable.
build --local_resources=cpu=10

# The build uses the pinned toolchain only. Do not look for a host C++ compiler.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
# apple_support detects Xcode by itself and reads this other variable.
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
# The default Python bootstrap needs python3 on the host PATH.
build --@rules_python//python/config_settings:bootstrap_impl=script


# Remote execution on a Linux x86_64 executor. Add the endpoint and the TLS flags to ~/.bazelrc:
#   build:remote-exec --remote_executor=grpcs://HOST:PORT
# The Node build is one action. It runs 6 compile jobs here and 5 in Docker. resource_set applies
# only to local execution, and the scheduler does not read it. docs/HERMETICITY.md has the measurements.
# The macOS build cannot run remotely, because the SDK comes from the host.
build:remote-exec --define=rootbeer_remote=1
build:remote-exec --platforms=//platforms:linux_x64_rbe
build:remote-exec --host_platform=//platforms:linux_x64_rbe
build:remote-exec --extra_execution_platforms=//platforms:linux_x64_rbe
build:remote-exec --spawn_strategy=remote
build:remote-exec --noremote_local_fallback
build:remote-exec --remote_timeout=3h
build:remote-exec --remote_download_toplevel

# Opt-in: a pinned macOS SDK from a private tarball. No build needs this config.
# The Apple license does not allow a public copy. Never publish the tarball.
# Put the address and the checksum in ~/.bazelrc, not in this file. tools/pack_macos_sdk.py prints them:
#   common:pinned-sdk --repo_env=ROOTBEER_PINNED_SDK_URL=file:///PRIVATE/PATH/MacOSX.sdk.tar.gz
#   common:pinned-sdk --repo_env=ROOTBEER_PINNED_SDK_SHA256=HEX
# The SDK files are action inputs, so this config turns off each service that can receive them.
# Put --config=pinned-sdk last. A later flag can turn a service on again.
common:pinned-sdk --repo_env=ROOTBEER_PINNED_SDK=1
build:pinned-sdk --remote_executor=
build:pinned-sdk --remote_cache=
build:pinned-sdk --bes_backend=
build:pinned-sdk --experimental_remote_downloader=

try-import %workspace%/user.bazelrc
