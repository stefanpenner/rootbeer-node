load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

exports_files(glob(["*.py", "*.js"]))

py_library(
    name = "repro_check_lib",
    srcs = ["repro_check.py"],
    imports = ["."],
    visibility = ["//tests:__pkg__"],
)

# bazel run //tools:repro_check -- 22
py_binary(
    name = "repro_check",
    srcs = ["repro_check.py"],
    main = "repro_check.py",
)

# tests/runtimes_test.py runs the same filter that the CI matrix step runs.
alias(
    name = "jq",
    actual = select({
        "@platforms//os:macos": "@jq_macos_arm64//file",
        "@platforms//os:linux": "@jq_linux_amd64//file",
    }),
    visibility = ["//tests:__pkg__"],
)
