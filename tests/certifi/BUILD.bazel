load("@rules_python//python:py_test.bzl", "py_test")

COMMON_DATA = [
    "//certifi:rootbeerz_certifi",
    "//tests:fixtures/emsign-roots.pem",
    "//tests:fixtures/empty.pem",
    "//trust:mozilla-no-emsign.pem",
    "@certifi_stock//:certifi.whl",
]

COMMON_ENV = {
    "CERTIFI_SHIM_WHEEL": "$(rootpath //certifi:rootbeerz_certifi)",
    "CERTIFI_STOCK_WHEEL": "$(rootpath @certifi_stock//:certifi.whl)",
    "EMSIGN_STORE": "$(rootpath //tests:fixtures/emsign-roots.pem)",
    "EMPTY_STORE": "$(rootpath //tests:fixtures/empty.pem)",
    "PINNED_STORE": "$(rootpath //trust:mozilla-no-emsign.pem)",
}

py_test(
    name = "hermetic_test",
    srcs = [
        "hermetic_test.py",
        "probelib.py",
    ],
    imports = ["."],
    data = COMMON_DATA + [
        "//runtimes:certifi.json",
        "//tests:fixtures/testonly-ca.pem",
        "//tests:fixtures/testonly-leaf.key",
        "//tests:fixtures/testonly-leaf.pem",
    ],
    env = COMMON_ENV | {
        "CERTIFI_MANIFEST": "$(rootpath //runtimes:certifi.json)",
        "TEST_CA": "$(rootpath //tests:fixtures/testonly-ca.pem)",
        "TEST_LEAF": "$(rootpath //tests:fixtures/testonly-leaf.pem)",
        "TEST_LEAF_KEY": "$(rootpath //tests:fixtures/testonly-leaf.key)",
    },
    size = "small",
)

py_test(
    name = "network_test",
    srcs = [
        "network_test.py",
        "probelib.py",
    ],
    imports = ["."],
    deps = ["//tests:trustlib"],
    data = COMMON_DATA,
    env = COMMON_ENV,
    size = "large",
    tags = [
        "external",
        "no-cache",
        "no-remote",
        "requires-network",
    ],
)
