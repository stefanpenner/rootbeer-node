load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "sourcelib",
    srcs = ["sourcelib.py"],
    imports = ["."],
)

py_test(
    name = "source_test",
    srcs = ["source_test.py"],
    data = [
        "//runtimes:bun.json",
        "@bun_1_src//:package.json",
        "@bun_1_src//:root_sources",
        "@bun_1_tarball//file",
    ],
    env = {
        "BUN_PATCHED_MARKER": "$(rootpath @bun_1_src//:package.json)",
        "BUN_TARBALL": "$(rootpath @bun_1_tarball//file)",
        "RUNTIME_MANIFEST": "$(rootpath //runtimes:bun.json)",
    },
    size = "small",
    deps = [":sourcelib"],
)

alias(
    name = "stock_bun",
    actual = select({
        "@platforms//os:macos": "@bun_1_stock_darwin_arm64//:bun",
        "//conditions:default": "@bun_1_stock_linux_x64//:bun",
    }),
)

_FIXTURES = [
    "probe_fetch.js",
    "root_count.js",
    "//runtimes:bun.json",
    "//tests:fixtures/empty.pem",
    "//tests:fixtures/emsign-roots.pem",
    "//tests:fixtures/testonly-ca.pem",
    "//tests:fixtures/testonly-leaf.key",
    "//tests:fixtures/testonly-leaf.pem",
    "//tests:probe.js",
    "//trust:mozilla-no-emsign.pem",
]

_ENV = {
    "EMPTY_STORE": "$(rootpath //tests:fixtures/empty.pem)",
    "EMSIGN_STORE": "$(rootpath //tests:fixtures/emsign-roots.pem)",
    "PINNED_STORE": "$(rootpath //trust:mozilla-no-emsign.pem)",
    "PROBE_FETCH": "$(rootpath probe_fetch.js)",
    "PROBE_HTTPS": "$(rootpath //tests:probe.js)",
    "ROOT_COUNT_JS": "$(rootpath root_count.js)",
    "RUNTIME_MANIFEST": "$(rootpath //runtimes:bun.json)",
    "TEST_CA": "$(rootpath //tests:fixtures/testonly-ca.pem)",
    "TEST_LEAF": "$(rootpath //tests:fixtures/testonly-leaf.pem)",
    "TEST_LEAF_KEY": "$(rootpath //tests:fixtures/testonly-leaf.key)",
}

py_library(
    name = "hermetic_lib",
    srcs = ["hermetic_test.py"],
    imports = ["."],
    deps = ["//tests:trustlib"],
)

# Needs no Bun build.
py_test(
    name = "stock_control_test",
    srcs = ["hermetic_test.py"],
    main = "hermetic_test.py",
    args = ["StockControl"],
    data = _FIXTURES + [":stock_bun"],
    env = _ENV | {"STOCK_BUN": "$(rootpath :stock_bun)"},
    size = "medium",
    deps = ["//tests:trustlib"],
)

# Needs no Bun build. It fails if the no-roots tests stop failing on the stock binary.
py_test(
    name = "stock_teeth_test",
    srcs = ["stock_teeth_test.py"],
    data = _FIXTURES + [":stock_bun"],
    env = _ENV | {"STOCK_BUN": "$(rootpath :stock_bun)"},
    size = "medium",
    deps = [
        ":hermetic_lib",
        "//tests:trustlib",
    ],
)
