load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@node_versions//:versions.bzl", "NODE_VERSIONS")
load(":defs.bzl", "rootbeer_tests")

py_library(
    name = "trustlib",
    srcs = [
        "crypto_bundle.py",
        "teethlib.py",
        "trustlib.py",
    ],
    imports = ["."],
)

[rootbeer_tests(major, version) for major, version in NODE_VERSIONS.items()]

py_test(
    name = "ci_test",
    srcs = ["ci_test.py"],
    data = [
        "//:.bazelversion",
        "//.github/actions/build:action.yml",
        "//.github/actions/setup-bazel:action.yml",
        "//.github/workflows:ci.yml",
    ],
    env = {
        "BAZELVERSION": "$(rootpath //:.bazelversion)",
        "SETUP_BAZEL_ACTION": "$(rootpath //.github/actions/setup-bazel:action.yml)",
        "BUILD_ACTION": "$(rootpath //.github/actions/build:action.yml)",
        "WORKFLOW": "$(rootpath //.github/workflows:ci.yml)",
    },
    size = "small",
)

py_test(
    name = "bazel_config_test",
    srcs = ["bazel_config_test.py"],
    data = [
        "//:.bazelrc",
        "//:.gitignore",
        "//:MODULE.bazel.lock",
        "//:README.md",
        "//.github/actions/build:action.yml",
        "//bazel:BUILD.bazel",
        "//node:defs.bzl",
        "//platforms:BUILD.bazel",
    ],
    env = {
        "BAZEL_BUILD": "$(rootpath //bazel:BUILD.bazel)",
        "NODE_DEFS": "$(rootpath //node:defs.bzl)",
        "PLATFORMS": "$(rootpath //platforms:BUILD.bazel)",
        "BAZELRC": "$(rootpath //:.bazelrc)",
        "GITIGNORE": "$(rootpath //:.gitignore)",
        "LOCKFILE": "$(rootpath //:MODULE.bazel.lock)",
        "TEXTS": "readme=$(rootpath //:README.md) build_action=$(rootpath //.github/actions/build:action.yml)",
    },
    size = "small",
)

py_test(
    name = "sdk_inputs_test",
    srcs = ["sdk_inputs_test.py"],
    data = [
        "//bazel:BUILD.bazel",
        "@macos_sdk//:files",
        "@macos_sdk//:info.json",
    ],
    env = {
        "BAZEL_BUILD": "$(rootpath //bazel:BUILD.bazel)",
        "SDK_INFO": "$(rootpath @macos_sdk//:info.json)",
    },
    size = "small",
)

py_test(
    name = "repro_check_test",
    srcs = ["repro_check_test.py"],
    deps = ["//tools:repro_check_lib"],
    size = "small",
)

py_test(
    name = "repo_rules_test",
    srcs = ["repo_rules_test.py"],
    data = [
        "//:MODULE.bazel",
        "//bazel:node_versions.bzl",
        "//bazel:sdk.bzl",
    ],
    env = {
        "FILES": "module=$(rootpath //:MODULE.bazel) node_versions=$(rootpath //bazel:node_versions.bzl) sdk=$(rootpath //bazel:sdk.bzl)",
    },
    size = "small",
)

py_test(
    name = "docker_test",
    srcs = ["docker_test.py"],
    data = [
        "//:README.md",
        "//docker:Dockerfile",
        "//docker:Dockerfile.dockerignore",
        "//docker:context",
        "//docs:HERMETICITY.md",
        "//trust:mozilla-no-emsign.pem",
    ],
    env = {
        "BUILD_CONTEXT": ".",
        "DOCKERFILE": "$(rootpath //docker:Dockerfile)",
    },
    size = "small",
)

# Needs Docker and a built image. See the docstring of image_test.py.
py_test(
    name = "image_test",
    srcs = ["image_test.py"],
    data = ["//trust:mozilla-no-emsign.pem"],
    env = {"TRUST_BUNDLE": "$(rootpath //trust:mozilla-no-emsign.pem)"},
    size = "medium",
    tags = [
        "external",
        "local",
        "manual",
        "no-cache",
        "no-remote",
        "no-sandbox",
        "requires-docker",
    ],
)

# One target per kind, so a caller never names the lines.
[test_suite(
    name = kind + "_tests",
    tests = [":%s_%d_test" % (kind, major) for major in NODE_VERSIONS],
) for kind in ("source", "source_mutation", "stock_teeth", "hermetic", "network")]

py_test(
    name = "versions_test",
    srcs = ["versions_test.py"],
    data = [
        "//:MODULE.bazel",
        "//:README.md",
        "//:STATUS.md",
        "//.github/workflows:ci.yml",
        "//patches:all",
        "//tools:make_patches.py",
        "@node_versions//:versions.json",
    ],
    env = {
        "VERSIONS_JSON": "$(rootpath @node_versions//:versions.json)",
        "MODULE_BAZEL": "$(rootpath //:MODULE.bazel)",
        "README": "$(rootpath //:README.md)",
        "STATUS": "$(rootpath //:STATUS.md)",
        "WORKFLOW": "$(rootpath //.github/workflows:ci.yml)",
        "MAKE_PATCHES": "$(rootpath //tools:make_patches.py)",
        "PATCHES": "$(rootpaths //patches:all)",
    },
    size = "small",
)

py_test(
    name = "make_patches_test",
