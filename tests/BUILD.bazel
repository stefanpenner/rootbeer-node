load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//:versions.bzl", "NODE_VERSIONS")
load(":defs.bzl", "rootbeer_tests")

py_library(
    name = "trustlib",
    srcs = [
        "crypto_bundle.py",
        "trustlib.py",
    ],
    imports = ["."],
)

[rootbeer_tests(major, version) for major, version in NODE_VERSIONS.items()]

py_test(
    name = "ci_test",
    srcs = ["ci_test.py"],
    data = [
        "//:.bazelversion",
        "//.github/actions/build:action.yml",
        "//.github/actions/setup-bazel:action.yml",
        "//.github/workflows:ci.yml",
    ],
    env = {
        "BAZELVERSION": "$(rootpath //:.bazelversion)",
        "SETUP_BAZEL_ACTION": "$(rootpath //.github/actions/setup-bazel:action.yml)",
        "BUILD_ACTION": "$(rootpath //.github/actions/build:action.yml)",
        "WORKFLOW": "$(rootpath //.github/workflows:ci.yml)",
    },
    size = "small",
)

py_test(
    name = "docker_test",
    srcs = ["docker_test.py"],
    data = [
        "//:README.md",
        "//docker:Dockerfile",
        "//docker:Dockerfile.dockerignore",
        "//docker:context",
        "//docs:HERMETICITY.md",
        "//trust:mozilla-no-emsign.pem",
    ],
    env = {
        "BUILD_CONTEXT": ".",
        "DOCKERFILE": "$(rootpath //docker:Dockerfile)",
    },
    size = "small",
)

# Needs Docker and a built image. See the docstring of image_test.py.
py_test(
    name = "image_test",
    srcs = ["image_test.py"],
    data = ["//trust:mozilla-no-emsign.pem"],
    env = {"TRUST_BUNDLE": "$(rootpath //trust:mozilla-no-emsign.pem)"},
    size = "medium",
    tags = [
        "external",
        "local",
        "manual",
        "no-cache",
        "no-remote",
        "no-sandbox",
        "requires-docker",
    ],
)
