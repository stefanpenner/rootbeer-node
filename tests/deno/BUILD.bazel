load("@rules_python//python:py_test.bzl", "py_test")

_SOURCE_ENV = {
    "CARGO_LOCK": "$(rootpath @deno_2_src//:Cargo.lock)",
    "CARGO_TOML": "$(rootpath @deno_2_src//:Cargo.toml)",
    "ESZIP_CARGO_TOML": "$(rootpath @deno_2_src//:libs/eszip/Cargo.toml)",
    "TLS_CARGO_TOML": "$(rootpath @deno_2_src//:ext/tls/Cargo.toml)",
    "NODE_CARGO_TOML": "$(rootpath @deno_2_src//:ext/node/Cargo.toml)",
    "CLI_ARGS_RS": "$(rootpath @deno_2_src//:cli/lib/args.rs)",
    "TLS_LIB_RS": "$(rootpath @deno_2_src//:ext/tls/lib.rs)",
    "NODE_TLS_RS": "$(rootpath @deno_2_src//:ext/node/ops/tls.rs)",
}

_SOURCE_DATA = [
    "@deno_2_src//:Cargo.lock",
    "@deno_2_src//:Cargo.toml",
    "@deno_2_src//:libs/eszip/Cargo.toml",
    "@deno_2_src//:ext/tls/Cargo.toml",
    "@deno_2_src//:ext/node/Cargo.toml",
    "@deno_2_src//:cli/lib/args.rs",
    "@deno_2_src//:ext/tls/lib.rs",
    "@deno_2_src//:ext/node/ops/tls.rs",
]

py_test(
    name = "source_2_test",
    srcs = ["source_test.py"],
    main = "source_test.py",
    deps = ["//tests:trustlib"],
    data = _SOURCE_DATA,
    env = _SOURCE_ENV,
    size = "small",
)

py_test(
    name = "source_mutation_2_test",
    srcs = [
        "source_mutation_test.py",
        "source_test.py",
    ],
    main = "source_mutation_test.py",
    imports = ["."],
    deps = ["//tests:trustlib"],
    data = _SOURCE_DATA + ["//deno:patches"],
    env = _SOURCE_ENV | {"DENO_PATCHES": "$(rootpaths //deno:patches)"},
    size = "small",
)

_MACOS_ARM64 = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

_COMMON_DATA = [
    "//deno:stock_2",
    "//tests:fixtures/empty.pem",
    "//tests:fixtures/emsign-roots.pem",
    "//trust:mozilla-no-emsign.pem",
    "probe.ts",
]

_COMMON_ENV = {
    "STOCK_DENO": "$(rootpath //deno:stock_2)",
    "EMPTY_STORE": "$(rootpath //tests:fixtures/empty.pem)",
    "EMSIGN_STORE": "$(rootpath //tests:fixtures/emsign-roots.pem)",
    "PINNED_STORE": "$(rootpath //trust:mozilla-no-emsign.pem)",
    "PROBE_TS": "$(rootpath probe.ts)",
}

_LOOPBACK_DATA = _COMMON_DATA + [
    "//tests:fixtures/testonly-ca.pem",
    "//tests:fixtures/testonly-leaf.key",
    "//tests:fixtures/testonly-leaf.pem",
    "root_count.ts",
]

_LOOPBACK_ENV = _COMMON_ENV | {
    "ROOT_COUNT_TS": "$(rootpath root_count.ts)",
    "TEST_CA": "$(rootpath //tests:fixtures/testonly-ca.pem)",
    "TEST_LEAF": "$(rootpath //tests:fixtures/testonly-leaf.pem)",
    "TEST_LEAF_KEY": "$(rootpath //tests:fixtures/testonly-leaf.key)",
}

_ROOTBEERZ_ENV = {"ROOTBEER_DENO": "$(rootpath //deno:rootbeerz_2)"}

# The stock binary is a download, so this test needs no Deno build.
py_test(
    name = "stock_teeth_2_test",
    srcs = ["hermetic_test.py"],
    main = "hermetic_test.py",
    args = ["StockControl"],
    deps = ["//tests:trustlib"],
    data = _LOOPBACK_DATA,
    env = _LOOPBACK_ENV,
    size = "medium",
    target_compatible_with = _MACOS_ARM64,
)

# Manual, because a wildcard must not start the Deno build.
py_test(
    name = "hermetic_2_test",
    srcs = ["hermetic_test.py"],
    main = "hermetic_test.py",
    deps = ["//tests:trustlib"],
    data = _LOOPBACK_DATA + [
        "//deno:rootbeerz_2",
        "//runtimes:deno.json",
    ],
    env = _LOOPBACK_ENV | _ROOTBEERZ_ENV | {
        "DENO_LINE": "2",
        "RUNTIME_MANIFEST": "$(rootpath //runtimes:deno.json)",
    },
    size = "medium",
    tags = ["manual"],
    target_compatible_with = _MACOS_ARM64,
)

py_test(
    name = "network_2_test",
    srcs = ["network_test.py"],
    main = "network_test.py",
    deps = ["//tests:trustlib"],
    data = _COMMON_DATA + ["//deno:rootbeerz_2"],
    env = _COMMON_ENV | _ROOTBEERZ_ENV,
    size = "large",
    tags = [
        "external",
        "manual",
        "no-cache",
        "no-remote",
        "requires-network",
    ],
    target_compatible_with = _MACOS_ARM64,
)
